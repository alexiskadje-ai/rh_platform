generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  RECRUITER
  CANDIDATE
  EMPLOYEE
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum CompanyStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum ContractType {
  CDI
  CDD
  STAGE
  PRESTATION
}

enum ApplicationStatus {
  RECEIVED
  SHORTLISTED
  INTERVIEW
  ACCEPTED
  REJECTED
}

enum JobVisibility {
  PUBLIC
  INVITE
}

enum JobStatus {
  OPEN
  CLOSED
}

enum InterviewFormat {
  ONSITE
  VIDEO
  PHONE
}

enum AiCallKind {
  PARSE_CV
  EMBEDDING
  MATCH
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeaveType {
  ANNUAL
  SICK
  UNPAID
  MATERNITY
  OTHER
}

enum PaymentProvider {
  MTN_MOMO
  ORANGE_MONEY
  CARD
  BANK_TRANSFER
}

enum TokenType {
  EMAIL
  SMS
  LOGIN
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  phone           String?   @unique
  firstName       String
  lastName        String
  passwordHash    String
  role            Role
  status          UserStatus @default(PENDING)
  twoFactorSecret String?
  isVerified      Boolean   @default(false)
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  termsAcceptedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company   Company? @relation(fields: [companyId], references: [id])
  companyId String?

  candidate      Candidate?
  employee       Employee?
  notifications  Notification[]
  enrollments    Enrollment[]
  orders         Order[]
  tokens         VerificationToken[]
  trustedDevices TrustedDevice[]
  aiCallLogs     AiCallLog[]
}

model Company {
  id                String        @id @default(cuid())
  name              String
  sector            String
  address           String?
  commerceRegister  String?
  status            CompanyStatus @default(PENDING)
  validatedAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  users       User[]
  jobOffers   JobOffer[]
  employees   Employee[]
  subscription Subscription?
}

model Candidate {
  id             String   @id @default(cuid())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String   @unique
  photoUrl       String?
  headline       String?
  bio            String?
  cvUrl          String?
  skills         String[]
  availability   String?
  availableFrom  DateTime?
  city           String?
  region         String?
  desiredContractTypes ContractType[]
  parsedCvRaw    Json?
  cvEmbedding    Unsupported("vector(1536)")?
  embeddingInputHash String?
  educations     Education[]
  experiences    Experience[]
  certifications Certification[]
  applications   Application[]
  matchScores    MatchScore[]
}

model JobOffer {
  id                 String         @id @default(cuid())
  company            Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId          String
  title              String
  description        String
  requirements       String
  city               String
  region             String
  location           String
  contractType       ContractType
  salary             Int?
  salaryMin          Int?
  salaryMax          Int?
  salaryNegotiable   Boolean        @default(false)
  hideSalary         Boolean        @default(false)
  coverLetterRequired Boolean       @default(false)
  deadline           DateTime
  positionsCount     Int            @default(1)
  visibility         JobVisibility  @default(PUBLIC)
  status             JobStatus      @default(OPEN)
  closedAt           DateTime?
  offerEmbedding     Unsupported("vector(1536)")?
  embeddingInputHash String?
  applications       Application[]
  matchScores        MatchScore[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

model Application {
  id                String            @id @default(cuid())
  candidate         Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  candidateId       String
  jobOffer          JobOffer          @relation(fields: [jobOfferId], references: [id], onDelete: Cascade)
  jobOfferId        String
  status            ApplicationStatus @default(RECEIVED)
  statusChangedAt   DateTime          @default(now())
  notes             String?
  coverLetter       String?
  coverLetterUrl    String?
  cvUrl             String
  salaryExpectation Int?
  availabilityDate  DateTime?
  matchScore        Float?
  createdAt         DateTime          @default(now())
  history           ApplicationStatusEvent[]
  interview         Interview?

  @@unique([candidateId, jobOfferId])
}

model ApplicationStatusEvent {
  id            String            @id @default(cuid())
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId String
  status        ApplicationStatus
  createdAt     DateTime          @default(now())
}

model Interview {
  id             String          @id @default(cuid())
  application    Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId  String          @unique
  scheduledAt    DateTime
  format         InterviewFormat
  locationOrLink String?
  message        String?
  createdAt      DateTime        @default(now())
}

model MatchScore {
  id          String    @id @default(cuid())
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  candidateId String
  jobOffer    JobOffer  @relation(fields: [jobOfferId], references: [id], onDelete: Cascade)
  jobOfferId  String
  score       Float
  breakdown   Json?
  computedAt  DateTime  @default(now())

  @@unique([candidateId, jobOfferId])
}

model AiCallLog {
  id        String     @id @default(cuid())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  kind      AiCallKind
  ok        Boolean
  message   String?
  createdAt DateTime   @default(now())

  @@index([userId, kind, createdAt])
}

model Certification {
  id          String    @id @default(cuid())
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  candidateId String
  name        String
  issuer      String?
  year        Int?
  fileUrl     String?
}

model Employee {
  id                 String       @id @default(cuid())
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String       @unique
  company            Company      @relation(fields: [companyId], references: [id])
  companyId          String
  matricule          String       @unique
  position           String
  department         String
  contractType       ContractType
  hireDate           DateTime
  birthDate          DateTime?
  address            String?
  emergencyName      String?
  emergencyPhone     String?
  expectedStartTime  String       @default("08:00")
  expectedEndTime    String       @default("17:00")
  workDays           Int[]        @default([1, 2, 3, 4, 5])
  managerId          String?
  manager            Employee?    @relation("EmployeeManager", fields: [managerId], references: [id])
  reports            Employee[]   @relation("EmployeeManager")
  documents          Document[]
  leaves             LeaveRequest[]
  attendances        Attendance[]
  absences           Absence[]
}

model Document {
  id         String   @id @default(cuid())
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String
  type       String
  fileUrl    String
  uploadedAt DateTime @default(now())
}

model LeaveRequest {
  id               String      @id @default(cuid())
  employee         Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId       String
  type             LeaveType
  startDate        DateTime
  endDate          DateTime
  days             Float
  status           LeaveStatus @default(PENDING)
  reason           String?
  justificationUrl String?
  alertedAt        DateTime?
  decidedAt        DateTime?
  createdAt        DateTime    @default(now())
}

model Attendance {
  id              String    @id @default(cuid())
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId      String
  date            DateTime
  checkIn         DateTime?
  checkOut        DateTime?
  lateMinutes     Int       @default(0)
  overtimeMinutes Int       @default(0)
  autoClosed      Boolean   @default(false)

  @@unique([employeeId, date])
}

model Absence {
  id               String    @id @default(cuid())
  employee         Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId       String
  startDate        DateTime
  endDate          DateTime
  reason           String
  justificationUrl String?
  validated        Boolean   @default(false)
  alertedAt        DateTime?
  createdAt        DateTime  @default(now())
}

model Course {
  id           String       @id @default(cuid())
  title        String
  description  String
  category     String
  price        Int          @default(0)
  passingScore Int          @default(70)
  accessMode   String       @default("LINEAR")
  videos       String[]
  documents    String[]
  modules      Json         @default("[]")
  quiz         Json         @default("[]")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  enrollments  Enrollment[]
}

model Enrollment {
  id                  String    @id @default(cuid())
  course              Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId            String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId              String
  progress            Int       @default(0)
  completedModuleIds  String[]  @default([])
  quizScore           Int?
  certificateUrl      String?
  enrolledAt          DateTime  @default(now())

  @@unique([courseId, userId])
}

model Product {
  id      String      @id @default(cuid())
  title   String
  type    String
  price   Int
  fileUrl String
  orders  OrderItem[]
}

model Order {
  id        String      @id @default(cuid())
  user      User        @relation(fields: [userId], references: [id])
  userId    String
  items     OrderItem[]
  total     Int
  payment   Payment?
  createdAt DateTime    @default(now())
}

model OrderItem {
  id        String  @id @default(cuid())
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  quantity  Int     @default(1)
}

model Payment {
  id        String          @id @default(cuid())
  order     Order?          @relation(fields: [orderId], references: [id])
  orderId   String?         @unique
  provider  PaymentProvider
  amount    Int
  status    String
  reference String          @unique
  createdAt DateTime        @default(now())
}

model Subscription {
  id        String   @id @default(cuid())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String   @unique
  plan      String
  status    String
  renewsAt  DateTime
}

model Notification {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  channel   String
  message   String
  sentAt    DateTime?
  createdAt DateTime  @default(now())
}

model Education {
  id          String    @id @default(cuid())
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  candidateId String
  degree      String
  institution String
  year        Int
}

model Experience {
  id          String    @id @default(cuid())
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  candidateId String
  title       String
  company     String
  startDate   DateTime
  endDate     DateTime?
}

model VerificationToken {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  type      TokenType
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId, type])
}

model TrustedDevice {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}
